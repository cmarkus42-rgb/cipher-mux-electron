{
  "name": "cipher-mux-electron",
  "version": "0.2.0",
  "description": "Electron-basierte Kommandozentrale für Claude Code Projekte",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "start": "electron .",
    "prestart": "electron-builder install-app-deps 2>/dev/null || true",
    "test": "npm run rebuild:node && node --test --import tsx $(find test -name '*.test.ts' | sort)",
    "rebuild:node": "cd node_modules/better-sqlite3 && npx node-gyp rebuild --release 2>/dev/null",
    "rebuild:electron": "npx electron-rebuild -f -w better-sqlite3",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.10.0",
    "ulidx": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/better-sqlite3": "^7.6.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.0.0",
    "preact": "^10.24.0",
    "prettier": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "author": "cipher",
  "license": "MIT"
}
